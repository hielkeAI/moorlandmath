{
  "name": "HomeworkProgress",
  "type": "object",
  "properties": {
    "homework_id": {
      "type": "string"
    },
    "classroom_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "answered": {
      "type": "number",
      "default": 0
    },
    "correct": {
      "type": "number",
      "default": 0
    },
    "question_count": {
      "type": "number",
      "default": 10
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "complete"
      ],
      "default": "in_progress"
    },
    "completed_date": {
      "type": "string"
    }
  },
  "required": [
    "homework_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}